//this is a comment

func sum(int a, int b) {
    return a + b;
}

// oneline functions works too
func mul(int a, int b) { return a * b; }

func main() {
    int a = 20;
    int b = 10;

    int s = sum(a, b);
    int m = mul(a, b); // can also print directly using print(mul(a, b));

    print(s);
    print(m);
}

main();