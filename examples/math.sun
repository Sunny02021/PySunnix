func add(int a, int b) {
    return a + b;
}

func sub(int a, int b) {
    return a - b;
}

func mul(int a, int b) {
    return a * b;
}

func div(int a, int b) {
    return a / b;
}

func main() {
    int a = 100;
    int b = 20;

    print(add(a, b));
    print(sub(a, b));
    print(mul(a, b));
    print(div(a, b));
}

main();